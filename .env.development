# Chargé par Next quand NODE_ENV=development (`next dev`). Commité : aucun
# secret, et le port est celui du script `dev` de package.json.
# Le pendant de production vit dans `.env.production` — lis-y le pourquoi.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Les deux sites du dépôt : `npm run dev` (portfolio, 3010) et
# `npm run dev:blog` (journal, 3011). Cf. .env.production.
NEXT_PUBLIC_PHOTO_URL=http://localhost:3010
NEXT_PUBLIC_BLOG_URL=http://localhost:3011

# Chemin de base du site. Vide en dev pour que `next dev` serve à la racine.
# Lu à la fois par next.config.ts (basePath) et par lib/utils/asset.ts.
NEXT_PUBLIC_BASE_PATH=
