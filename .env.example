# --- Sanity ---
# Crée un projet sur https://sanity.io/manage puis copie les valeurs ici.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Read token (facultatif) : brouillons pour le preview local et les scripts
# Jev (map:suggest, translate:check). Token **Viewer** seulement (audit 2.11) :
# il est en clair dans ce fichier, il ne doit rien pouvoir modifier.
SANITY_API_READ_TOKEN=

# Write token : JAMAIS dans ce fichier (audit 2.11). Il vit dans le trousseau
# (service sanity-write-yh5i5diw) ; les scripts d'écriture se lancent par
#   sanity-write npm run <script>
# qui le passe en variable d'environnement le temps de la commande.

# --- Site ---
# NEXT_PUBLIC_SITE_URL ne se met PAS ici : il est versionné, par environnement,
# dans `.env.development` et `.env.production`. Le poser dans un `.env.local`
# le ferait passer devant les deux (précédence Next) et un build de prod
# publierait une canonical localhost — bug réel, constaté en ligne le 2026-08-22.

# ─── Formulaire de contact ───────────────────────────────────────────────────
# INACTIF tant que le site est un export statique : sans serveur, la route
# /api/contact n'existe pas. Ces variables ne servent qu'après la migration
# serveur — marche à suivre complète dans docs/CONTACT-FORM.md.
#
# Affiche le formulaire sur /contact. Absent ou ≠ 1 → la page garde son seul
# lien email protégé. À poser dans l'environnement de BUILD (c'est un
# NEXT_PUBLIC_*, il est lu au rendu).
NEXT_PUBLIC_CONTACT_FORM=

# Envoi de l'email (Resend). SECRETS : jamais commités, à poser dans les
# variables d'environnement de l'hébergeur.
RESEND_API_KEY=
# Boîte qui reçoit les messages du formulaire.
CONTACT_TO=
# Expéditeur — DOIT être sur un domaine vérifié chez Resend, sinon les envois
# sont refusés ou classés en spam.
CONTACT_FROM=

# Chemin de base du site (sous-dossier GitHub Pages). Vide = site à la racine.
# Lu par next.config.ts ET lib/utils/asset.ts — une seule source, à ne pas
# dupliquer en littéral. Versionné par environnement (.env.development /
# .env.production), JAMAIS dans .env.local (qui passe devant et casse tout).
NEXT_PUBLIC_BASE_PATH=
