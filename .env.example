# --- Sanity ---
# Crée un projet sur https://sanity.io/manage puis copie les valeurs ici.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Read token (facultatif — uniquement pour drafts/preview en server).
# Génère un token "Editor" sur sanity.io/manage > API > Tokens.
SANITY_API_READ_TOKEN=

# Write token — requis UNIQUEMENT pour le script `npm run upload-photos`.
# Génère un token "Editor" ou "Deploy Studio" sur sanity.io/manage > API > Tokens.
# Ne le commit jamais. Tu peux le supprimer après l'upload.
SANITY_API_WRITE_TOKEN=

# --- Site ---
# NEXT_PUBLIC_SITE_URL ne se met PAS ici : il est versionné, par environnement,
# dans `.env.development` et `.env.production`. Le poser dans un `.env.local`
# le ferait passer devant les deux (précédence Next) et un build de prod
# publierait une canonical localhost — bug réel, constaté en ligne le 2026-08-22.
