{
  "name": "amatencio-photo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "dev:blog": "SITE_TARGET=blog next dev -p 3011",
    "build": "next build && node --import tsx scripts/csp-hashes.ts out",
    "build:blog": "SITE_TARGET=blog next build",
    "start": "next start -p 3010",
    "lint": "eslint .",
    "backup": "bash scripts/backup-client-files.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env.production --import tsx --test 'scripts/check-*.ts'",
    "clean": "rm -rf .next out",
    "predeploy": "bash scripts/deploy-guard.sh && npm run clean && npm run build",
    "deploy": "rsync -az --delete --chmod=Du=rwx,Dgo=rx,Fu=rw,Fgo=r out/ amatencio-vps:/srv/www/photo/",
    "deploy:blog": "bash scripts/deploy-guard.sh && rm -rf out-blog && npm run build:blog && rsync -az --delete --chmod=Du=rwx,Dgo=rx,Fu=rw,Fgo=r out-blog/ amatencio-vps:/srv/www/blog/",
    "upload-photos": "node --env-file=.env.production --env-file=.env.local --import tsx scripts/upload-photos.ts",
    "import-journal": "node --env-file=.env.local --import tsx scripts/import-journal.ts",
    "translate-post": "node --env-file=.env.local --import tsx scripts/translate-post.ts",
    "translate:check": "node --env-file-if-exists=.env.local --import tsx scripts/translate-check.ts",
    "migrate-taxonomy": "node --env-file=.env.local --import tsx scripts/migrate-taxonomy.ts",
    "migrate-series-multi": "node --env-file=.env.local --import tsx scripts/migrate-photo-series-multi.ts",
    "assign-series-by-location": "node --env-file=.env.local --import tsx scripts/assign-series-by-location.ts",
    "check-parser": "node --import tsx scripts/check-filename-parser.ts",
    "check-image-prep": "node --import tsx scripts/check-image-prep.ts",
    "check-search": "node --import tsx scripts/check-search.ts",
    "check-translate-markup": "node --import tsx scripts/check-translate-markup.ts",
    "check-map-anchors": "node --import tsx scripts/check-map-anchors.ts",
    "map:build": "node --env-file-if-exists=.env.local --import tsx scripts/map-build.ts",
    "map:check": "node --env-file-if-exists=.env.local --import tsx scripts/map-check.ts",
    "map:suggest": "node --env-file-if-exists=.env.local --import tsx scripts/map-suggest.ts",
    "map:rimes": "node --env-file-if-exists=.env.local --import tsx scripts/map-rimes.ts",
    "dump:file": "node --env-file-if-exists=.env.local --import tsx scripts/dump-file.ts",
    "map:translate": "node --env-file-if-exists=.env.local --import tsx scripts/map-translate.ts",
    "align-translation-keys": "node --env-file=.env.local --import tsx scripts/align-translation-keys.ts",
    "check-jsonld": "node --env-file=.env.production --import tsx scripts/check-jsonld.ts",
    "wipe-photos": "node --env-file=.env.local --import tsx scripts/wipe-photos.ts",
    "set-hero": "node --env-file=.env.production --env-file=.env.local --import tsx scripts/set-hero.ts",
    "audit-series": "node --env-file=.env.local --import tsx scripts/audit-photos-without-series.ts",
    "make-og-image": "node --env-file=.env.production --env-file=.env.local --import tsx scripts/make-og-image.ts",
    "make-og-journal": "node --import tsx scripts/make-og-journal.ts",
    "downsize-assets": "node --env-file=.env.production --env-file=.env.local --import tsx scripts/downsize-assets.ts",
    "purge-orphan-assets": "node --env-file=.env.local --import tsx scripts/purge-orphan-assets.ts",
    "csp:verify": "node --import tsx scripts/csp-verify.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.14.1",
    "@sanity/color-input": "^6.1.8",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.22.0",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "exifr": "^7.1.3",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "gsap": "^3.13.0",
    "lenis": "^1.1.20",
    "lucide-react": "^1.67.0",
    "next": "^16.4.4",
    "next-sanity": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-zoom-pan-pinch": "^4.0.3",
    "sanity": "^6.22.0",
    "sigma": "3.0.3",
    "styled-components": "^6.1.13",
    "tailwind-merge": "^3.7.0",
    "yaml": "2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "playwright": "^1.62.1",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "^3.15.2",
      "smol-toml": "^1.9.1"
    },
    "@module-federation/dts-plugin": {
      "undici": "^7.30.1"
    },
    "minimatch@^10": "^11.0.5"
  }
}
